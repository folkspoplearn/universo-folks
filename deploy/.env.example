# Produção (VPS). Copie para deploy/.env e preencha. O deploy/.env NUNCA vai para o git.
# Gere segredos com: openssl rand -hex 32
# A API se recusa a subir com segredo curto ou com valor "troque..." deste exemplo.

# --- Domínios (o DNS dos dois precisa apontar para a VPS) ---
WEB_DOMAIN=app.folkspoplearning.com.br
API_DOMAIN=api.folkspoplearning.com.br
# e-mail para o Let's Encrypt avisar sobre os certificados (obrigatório)
ACME_EMAIL=
# outras origens do navegador que podem chamar a API, separadas por vírgula (opcional)
CORS_EXTRA_ORIGINS=

# --- Banco (só na rede interna). Use senha só com letras e números (vai na URL de conexão) ---
POSTGRES_USER=folks
POSTGRES_DB=universo_folks
POSTGRES_PASSWORD=troque-por-openssl-rand-hex-32

# --- Auth ---
JWT_ACCESS_SECRET=troque-por-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Primeiro MASTER (usado só pelo seed). Troque a senha no primeiro acesso ---
SEED_MASTER_EMAIL=
SEED_MASTER_PASSWORD=

# --- Swagger em https://API_DOMAIN/docs (desligado em produção por padrão) ---
SWAGGER_ENABLED=false

# --- Vimeo ---
VIMEO_ACCESS_TOKEN=
VIMEO_EMBED_DOMAINS=app.folkspoplearning.com.br

# --- E-mail transacional (Resend). Vazio = convites e nova senha não são enviados ---
RESEND_API_KEY=
EMAIL_FROM=Folks Poplearning <nao-responda@folkspoplearning.com.br>

# --- RevenueCat (Premium nas lojas): header Authorization do webhook ---
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ACCEPT_SANDBOX=false

# --- Asaas (Premium na web + contratos de empresas) ---
# A chave começa com "$" ($aact_...). O Docker Compose trata "$" como variável:
# escreva entre aspas simples, ex.: ASAAS_API_KEY='$aact_prod_...', senão ela chega vazia.
ASAAS_API_KEY=
# sandbox: https://api-sandbox.asaas.com/v3 | produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# --- Backup (deploy/scripts/backup.sh) ---
# quantos dias de backup manter na VPS
BACKUP_KEEP_DAYS=14
# destino fora da VPS no rclone (ex.: r2:folks-backups). Vazio = só local
BACKUP_RCLONE_REMOTE=
